# ━━━ 깃허브에 올리지 않을 것 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
#  ⚠️ 이 저장소는 Public 입니다. 누구나 볼 수 있습니다.
#     아래에 적힌 것만 올라가지 않습니다.
#
#  2026-09-07 추가.
#  그전까지 이 파일이 없었습니다. .env 를 하나라도 만들었으면
#  솔라피·구글·제미나이 열쇠가 그대로 세상에 공개될 뻔했습니다.
#
#  ⚠️ 열쇠를 적은 파일을 새로 만들 때는 그 이름이 아래에 걸리는지
#     반드시 확인하세요. 안 걸리면 그대로 올라갑니다.

# ── 열쇠·비밀 ──
.env
.env.*
!.env.example
*credentials*.json
*service-account*.json
*secret*
*.pem
*.key

# ── 맥·윈도우가 멋대로 만드는 것 ──
.DS_Store
Thumbs.db

# ── 임시·기록 ──
*.log
logs/
*.tmp

# ── 남의 코드 (용량만 큽니다. npm install 로 다시 받습니다) ──
node_modules/

# ── Netlify 가 만드는 것 ──
.netlify/
